o3_pt_file="$RAD_DATA/gases/pt_o3_uv"
if [ ! -s ${sp_dir}/o3_uv_l ] ; then
  echo 'O3: far-UV - near-IR cross-section'
  rm -f ${sp_dir}/o3_uv_l* ${sp_dir}/o3_lbl_uv*
  ck_args="Ccorr_k -F $o3_pt_file -X $uv_o3 \
