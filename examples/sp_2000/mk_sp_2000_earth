  echo 'CO2: extreme UV - cross-section'
  rm -f ${sp_dir}/co2_euv_l* ${sp_dir}/co2_lbl_euv*
  ck_args="Ccorr_k -F $PT_SINGLE -UVX $uv_co2 \
    -R 11 100 -i 10.0 -l $IP_CO2 ${COL_MASS_K_CO2} -t 1.0e-3  \
    -s $skelfile +S $SOLSPEC \
    -o ${sp_dir}/co2_euv_l -m ${sp_dir}/co2_euv_lm \
    -L ${sp_dir}/co2_lbl_euv.nc -np $procs"
  if command -v sbatch &> /dev/null ; then
    sbatch -W -n $procs -o ${sp_dir}/co2_euv_log -t 60 ${ck_args} &
  else
    ${ck_args} > ${sp_dir}/co2_euv_log
  fi
fi
if [ ! -s ${sp_dir}/co2_fuv_l ] ; then
  echo 'CO2: far UV - cross-section'
  rm -f ${sp_dir}/co2_fuv_l* ${sp_dir}/co2_lbl_fuv*
  ck_args="Ccorr_k -F $PT_SINGLE -UVX $uv_co2 \
    -R 101 202 -i 1.0 -l $IP_CO2 ${COL_MASS_K_CO2} -t 1.0e-3  \
    -s $skelfile +S $SOLSPEC \
    -o ${sp_dir}/co2_fuv_l -m ${sp_dir}/co2_fuv_lm \
    -L ${sp_dir}/co2_lbl_fuv.nc -np $procs"
  if command -v sbatch &> /dev/null ; then
    sbatch -W -n $procs -o ${sp_dir}/co2_fuv_log -t 60 ${ck_args} &
  else
    ${ck_args} > ${sp_dir}/co2_fuv_log
  fi
fi

if [ ! -s $sp_dir/co2_nir_l ] ; then
  if [ ! -s $CO2_LBL ] ; then
    echo "CO2: No LBL file: please run ./mk_co2_lbl_2000_earth"
    exit 1
  else
    echo "CO2: near infra-red"
    rm -f $sp_dir/co2_nir_l*
    ck_args="Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 547 1000 -l $IP_CO2 ${COL_MASS_K_CO2} -b 5.0e-4 \
      -s $skelfile +S $SOLSPEC -lk \
      -o $sp_dir/co2_nir_l -m $sp_dir/co2_nir_lm \
      -L $CO2_LBL -np $procs"
    if command -v sbatch &> /dev/null ; then
      sbatch -W -n $procs -o $sp_dir/co2_nir_log -t 360 ${ck_args} &
    else
      ${ck_args} > $sp_dir/co2_nir_log
    fi
  fi
fi
if [ ! -s $sp_dir/co2_mir_l ] ; then
  if [ ! -s $CO2_LBL ] ; then
    echo "CO2: No LBL file: please run ./mk_co2_lbl_2000_earth"
    exit 1
  else
    echo "CO2: mid infra-red"
    rm -f $sp_dir/co2_mir_l*
    ck_args="Ccorr_k -F ${GAS_DATA_DIR}/${PT_FILE} \
      -R 1001 1500 -l $IP_CO2 ${COL_MASS_K_CO2} -b 5.0e-4 \
      -s $skelfile -u -lk \
      -o $sp_dir/co2_mir_l -m $sp_dir/co2_mir_lm \
