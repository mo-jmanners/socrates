    -R 11 100 -i 10.0 -l $IP_N2O ${COL_MASS_K_N2O} -t 1.0e-3  \
    -s $skelfile +S $SOLSPEC \
    -o ${sp_dir}/n2o_euv_l -m ${sp_dir}/n2o_euv_lm \
    -L ${sp_dir}/n2o_lbl_euv.nc -np $procs"
  if command -v sbatch &> /dev/null ; then
    sbatch -W -n $procs -o ${sp_dir}/n2o_euv_log -t 60 ${ck_args} &
  else
    ${ck_args} > ${sp_dir}/n2o_euv_log
  fi
fi
if [ ! -s ${sp_dir}/n2o_fuv_l ] ; then
