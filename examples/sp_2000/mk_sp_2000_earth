# ----------------------------
# Dinitrogen Oxide (N2O)
# ----------------------------
uv_n2o=${sp_dir}/n2o_208-298K.uvxsc  #  6 - 250 nm
n2o_pt_file="pt_n2o"

if [ ! -s $uv_n2o ] ; then
  rm -f n2o_???K.dat n2o_???K.uvxsc n2o_298K_ext.uvxsc
  calc_n2o_xsc
  cat n2o_298K_6-160nm.dat n2o_298K.dat > n2o_298K_ext.dat
  dat2xsc -t 208 n2o_208K.dat n2o_208K.uvxsc
  dat2xsc -t 238 n2o_238K.dat n2o_238K.uvxsc
  dat2xsc -t 268 n2o_268K.dat n2o_268K.uvxsc
  dat2xsc -t 298 n2o_298K_ext.dat n2o_298K_ext.uvxsc
  cat n2o_208K.uvxsc n2o_238K.uvxsc n2o_268K.uvxsc n2o_298K_ext.uvxsc > $uv_n2o
  rm -f n2o_???K.dat n2o_???K.uvxsc n2o_298K_ext.uvxsc n2o_298K_ext.dat
fi

if [ ! -s ${sp_dir}/n2o_xuv_l ] ; then
  echo 'N2O: XUV cross-section'
  rm -f ${sp_dir}/n2o_xuv_l* ${sp_dir}/n2o_lbl_xuv*
  ck_args="Ccorr_k -F $PT_SINGLE -UVX $uv_n2o \
    -R 7 10 -i 1000.0 -l $IP_N2O ${COL_MASS_K_N2O} -t 1.0e-3  \
    -s $skelfile +S $SOLSPEC \
    -o ${sp_dir}/n2o_xuv_l -m ${sp_dir}/n2o_xuv_lm \
    -L ${sp_dir}/n2o_lbl_xuv.nc -np $procs"
  if command -v sbatch &> /dev/null ; then
    sbatch -W -n $procs -o ${sp_dir}/n2o_xuv_log -t 60 ${ck_args} &
  else
    ${ck_args} > ${sp_dir}/n2o_xuv_log
  fi
fi
if [ ! -s ${sp_dir}/n2o_euv_l ] ; then
  echo 'N2O: EUV cross-section'
  rm -f ${sp_dir}/n2o_euv_l* ${sp_dir}/n2o_lbl_euv*
